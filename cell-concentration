<script>

function calculateConcentration() {

    const totalCount = parseFloat(
        document.getElementById("total-count").value
    );

    const shape =
        document.getElementById("shape").value;

    const shapesCount = parseFloat(
        document.getElementById("shapes-count").value
    );

    const dilutionFactor = parseFloat(
        document.getElementById("dilution-factor").value
    );


    // Check that the user entered valid numbers

    if (
        isNaN(totalCount) ||
        isNaN(shapesCount) ||
        isNaN(dilutionFactor) ||
        totalCount < 0 ||
        shapesCount <= 0 ||
        dilutionFactor <= 0
    ) {
        alert("Please enter valid numbers.");
        return;
    }


    // Calculate average number of objects per counted area

    const average = totalCount / shapesCount;


    // Calculate concentration according to the selected area

    let concentration;


    if (shape === "b") {

        concentration = average / 4;

    }

    else if (shape === "r") {

        concentration = average;

    }

    else if (shape === "s") {

        concentration = average * 4;

    }


    // Apply dilution factor

    concentration = concentration * dilutionFactor;


    // Round final result to three decimal places

    concentration = concentration.toFixed(3);


    // Display result

    const result =
        document.getElementById("result");

    result.innerHTML =
        concentration + " × 10⁶ objects/mL";

    result.style.display = "block";

}

</script>

